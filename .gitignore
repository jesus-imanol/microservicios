# Gitignore principal del proyecto de microservicios
# Creado por Jesús Imanol Castillo Avendaño

# Archivos de entorno con credenciales
.env
.env.local
.env.development
.env.test
# Nota: .env.production NO está ignorado porque contiene configuración de deployment público

# Archivos de Docker con datos sensibles
docker-compose.override.yml

# Logs
*.log
logs/

# Archivos temporales del sistema
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Directorios de IDEs
.vscode/
.idea/
*.sublime-*

# Datos de volúmenes de Docker (si se copian localmente)
mysql_data/
postgres_data/
